+// The demo being recorded so far, and the room left in its buffer
+UINT8 *G_DemoRecorded(size_t *len, size_t *room)
+{
+	*len = demo_p && demobuffer ? (size_t)(demo_p - demobuffer) : 0;
+	*room = demo_p && demobuffer ? (size_t)(demoend - demo_p) : 0;
+	return demo_p ? demobuffer : NULL;
+}
+
+// Where the ghosts are: x, y, z of each, at most max
+INT32 G_GhostPositions(fixed_t *xyz, INT32 max)
+{
+	INT32 n = 0;
+	demoghost *g;
+	for (g = ghosts; g && n < max; g = g->next, n++)
+	{
+		xyz[3*n] = g->mo->x;
+		xyz[3*n+1] = g->mo->y;
+		xyz[3*n+2] = g->mo->z;
+	}
+	return n;
+}
 
+// Clean up all ghosts (2.2's G_FreeGhosts)
+void G_FreeGhosts(void)
+{
 	while (ghosts)
 	{
 		demoghost *next = ghosts->next;
