{
  "coreName": "SRB2 Legacy",
  "systemId": "SRB2Legacy",
  "systemNames": {
    "SRB2Legacy": "SRB2 Legacy"
  },
  "kind": "game",
  "author": "Sonic Team Junior (Sonic Robo Blast 2, from Doom Legacy) and srb2-preservation (SRB2 Legacy); unofficial Chimera port by P-AS",
  "url": "https://github.com/P-AS/chimera-core-srb2-legacy",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's zone, its screens (five at the resolution, 41 MiB at 3840x2160) and the data files' cached lumps on the heap (and mmap past it), the engine's 16 MiB cothread stack in mmap; the picture's buffer (33 MiB at 3840x2160) and the sound's invisible (output, not the machine). As run-wbx has them.",
  "memoryLayoutMiB": [
    256,
    4,
    64,
    4,
    1024
  ],
  "video": {
    "_comment": "The software renderer at the resolution setting (up to 3840x2160), shown with square pixels as SRB2 is: the live size comes from GetVideoWidth/Height and the display aspect from GetDisplayAspectX/Y, which is that size itself.",
    "width": 3840,
    "height": 2160,
    "virtualWidth": 320,
    "virtualHeight": 200,
    "vsyncNumerator": 35,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The core's own mixer (platform/i_sound.c): a step is a tic, 1260 frames at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 1260,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "SRB2 Legacy Controller",
    "_comment": "SRB2 Legacy's keyboard, pressed as keys - the menus read them too - and the menus' Enter and Escape (a prompt's yes and no too); and axes added into the tic command for exact values (Forward Move and Side Move count only while their keys are not held; Aim 0 leaves the game's own look). Spin is 2.1's \"use\" control. The ring-slinger controls are in but for the weapon slots (Weapon 1-10), left out to keep the UI uncrowded: Weapon Next and Prev reach every weapon. The order is srb2-input.c's. The mnemonics are each button's letter in a movie's text and TAStudio's column: the directions as Doom has them, arrows for moving and braces for turning.",
    "buttons": [
      "Forward",
      "Backward",
      "Strafe Left",
      "Strafe Right",
      "Turn Left",
      "Turn Right",
      "Look Up",
      "Look Down",
      "Jump",
      "Spin",
      "Fire",
      "Fire Normal",
      "Toss Flag",
      "Center View",
      "Reset Camera",
      "Camera Toggle",
      "Weapon Next",
      "Weapon Prev",
      "Custom 1",
      "Custom 2",
      "Custom 3",
      "Pause",
      "Enter",
      "Escape"
    ],
    "mnemonics": {
      "Forward": "^",
      "Backward": "v",
      "Strafe Left": "<",
      "Strafe Right": ">",
      "Turn Left": "{",
      "Turn Right": "}",
      "Look Up": "U",
      "Look Down": "D",
      "Jump": "J",
      "Spin": "S",
      "Fire": "F",
      "Fire Normal": "N",
      "Toss Flag": "G",
      "Center View": "C",
      "Reset Camera": "R",
      "Camera Toggle": "T",
      "Weapon Next": "+",
      "Weapon Prev": "-",
      "Custom 1": "1",
      "Custom 2": "2",
      "Custom 3": "3",
      "Pause": "P",
      "Enter": "E",
      "Escape": "e"
    },
    "axes": [
      {
        "name": "Forward Move",
        "min": -50,
        "max": 50,
        "neutral": 0,
        "header": "Fwd"
      },
      {
        "name": "Side Move",
        "min": -50,
        "max": 50,
        "neutral": 0,
        "header": "Side"
      },
      {
        "name": "Turn",
        "min": -32768,
        "max": 32767,
        "neutral": 0,
        "header": "Turn"
      },
      {
        "name": "Aim",
        "min": -32768,
        "max": 32767,
        "neutral": 0,
        "header": "Aim"
      }
    ]
  },
  "settings": [
    {
      "name": "analogControl",
      "display": "Analog Control",
      "type": "bool",
      "default": false,
      "description": "2.1's Analog Control (useranalog): the player faces and moves where the input points, and the camera follows, instead of the player always facing where the camera looks. SRB2's own default is Off."
    },
    {
      "name": "cameraSpeed",
      "display": "Camera Speed",
      "type": "float",
      "default": 1.0,
      "description": "How fast the camera catches up with the player (cam_speed), 0 to 1; SRB2's own default is 0.3."
    },
    {
      "name": "cameraDistance",
      "display": "Camera Distance",
      "type": "float",
      "default": 192.0,
      "description": "How far behind the player the camera sits, in map units (cam_dist); SRB2 2.2's default. SRB2 Legacy's own is 160."
    },
    {
      "name": "cameraHeight",
      "display": "Camera Height",
      "type": "float",
      "default": 40.0,
      "description": "How high above the player the camera sits, in map units (cam_height); SRB2 2.2's default. SRB2 Legacy's own is 25."
    },
    {
      "name": "fov",
      "display": "Field of View",
      "type": "float",
      "default": 90.0,
      "description": "The camera's horizontal field of view in degrees (fov), 60 to 179, in both renderers; SRB2's default. Recommended: leave it at 90 for normal levels, and set it to 120 for NiGHTS levels, where the wider view shows more of the track ahead. The picture's alone: the game plays the same at every field of view."
    },
    {
      "name": "scoreTimeRings",
      "display": "Score/Time/Rings",
      "type": "enum",
      "options": [
        "Normal",
        "Centiseconds",
        "Mania",
        "Tics"
      ],
      "default": "Mania",
      "description": "How the HUD shows the time (timerres): Normal (m:ss), Centiseconds (m:ss.cc), Mania (m:ss.cc, the score and ring counts lined up under it, as in Sonic Mania), Tics (the level's tic count)."
    },
    {
      "name": "scorePos",
      "display": "Score Display",
      "type": "enum",
      "options": [
        "Normal",
        "Modern"
      ],
      "default": "Modern",
      "description": "Where the HUD draws the score's number (scorepos, SRB2 Legacy's Score Display), in play and at the intermission: Normal, where 2.1 draws it; Modern, 8 pixels further right, lined up with the time. SRB2 Legacy's own default is Normal. The picture's alone: the game plays the same with either."
    },
    {
      "name": "flipCamera",
      "display": "Flip Camera with Gravity",
      "type": "bool",
      "default": true,
      "description": "The camera turns upside down with the player's gravity (flipcam)."
    },
    {
      "name": "unlockModes",
      "display": "Unlock Record Attack and NiGHTS Mode",
      "type": "bool",
      "default": false,
      "description": "Start with Record Attack and NiGHTS Mode unlocked, so a run needs no movie that earns them. (SRB2 Legacy always offers Marathon Run.)"
    },
    {
      "name": "unlockMaps",
      "display": "Unlock All Maps in Record Attack and NiGHTS Mode",
      "type": "bool",
      "default": false,
      "description": "Every map Record Attack and NiGHTS Mode list can be picked, visited or not, an addon's maps included. Only the menu's check: the game data is untouched. The modes themselves need Unlock Record Attack and NiGHTS Mode."
    },
    {
      "name": "unlockAll",
      "display": "Unlock All Secrets",
      "type": "bool",
      "default": false,
      "description": "Start with every unlockable unlocked: the modes, Level Select, Sound Test, Pandora's Box, the emblem hints and radar, and the rest."
    },
    {
      "name": "musicPref",
      "display": "Music Preference",
      "type": "enum",
      "options": [
        "Digital",
        "MIDI"
      ],
      "default": "Digital",
      "description": "Which of a song's two versions plays (musicpref): Digital, the recorded music (Ogg Vorbis); MIDI, the game's MIDI songs played on six emulated Sega Genesis/Mega Drive YM2612 sound chips (MAME's), with the MIDI volume (midimusicvolume). A song with only one version plays that one. The sound's alone: the game plays the same with either."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl-hw"
      ],
      "default": "software",
      "description": "software: SRB2's software renderer. opengl-hw: SRB2's OpenGL renderer on this machine's GPU through Chimera's GPU bridge - fast, but the picture is the driver's and a run says it is not deterministic. With no bridge it draws in software, which plays differently, and the log says so. The renderer is part of the game (a few things play differently in OpenGL), so a movie plays back on the renderer it was made with."
    },
    {
      "name": "glShaders",
      "display": "OpenGL Shaders",
      "type": "bool",
      "default": true,
      "description": "The OpenGL renderer's shaders (gr_shaders): SRB2's lighting, fog and palette look. Off draws with its fixed stages. The picture's alone: the game is the same either way."
    },
    {
      "name": "resolution",
      "display": "Resolution",
      "type": "enum",
      "options": [
        "3840x2160",
        "2560x1440",
        "1920x1200",
        "1920x1080",
        "1680x1050",
        "1600x1200",
        "1600x1000",
        "1600x900",
        "1536x864",
        "1366x768",
        "1440x900",
        "1280x1024",
        "1280x960",
        "1280x800",
        "1280x720",
        "1152x864",
        "1024x768",
        "960x600",
        "800x600",
        "640x480",
        "640x400",
        "320x240",
        "320x200"
      ],
      "default": "1280x800",
      "description": "The picture's size, shown with square pixels: SRB2's own video modes, and 2560x1440 and 3840x2160 beyond them. SRB2's own default is 1280x800. Only the picture changes: the game plays identically at every resolution. Larger is slower to draw (turbo skips only the conversion)."
    },
    {
      "name": "warp",
      "display": "Start Map",
      "type": "string",
      "default": "",
      "description": "A map to start in, as the game's -warp takes it (a number, or MAPxx); empty for the game's own start, the intro and the title. SRB2 counts warping as modifying the game: game data is then not saved."
    },
    {
      "name": "skin",
      "display": "Start Map Character",
      "type": "string",
      "default": "",
      "description": "The character Start Map plays as, by skin name: sonic, tails, knuckles, or an addon's (the game's +skin). Empty for the game's default, Sonic. Used only with a Start Map; without one, the game's character select chooses."
    }
  ],
