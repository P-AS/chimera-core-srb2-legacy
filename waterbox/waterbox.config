{
  "coreName": "SRB2 Legacy",
  "systemId": "SRB2",
  "systemNames": {
    "SRB2": "Sonic Robo Blast 2"
  },
  "kind": "game",
  "author": "Sonic Team Junior (Sonic Robo Blast 2, from Doom Legacy) and srb2-preservation (SRB2 Legacy); unofficial Chimera port by P-AS",
  "url": "https://github.com/P-AS/chimera-core-srb2-legacy",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's zone, its screens (five at the resolution, 41 MiB at 3840x2160) and the data files' cached lumps on the heap (and mmap past it), the engine's 16 MiB cothread stack in mmap; the picture's buffer (33 MiB at 3840x2160) and the sound's invisible (output, not the machine). As run-wbx has them.",
  "memoryLayoutMiB": [
    256,
    4,
    64,
    4,
    1024
  ],
  "video": {
    "_comment": "The software renderer at the resolution setting (up to 3840x2160), shown with square pixels as SRB2 is: the live size comes from GetVideoWidth/Height and the display aspect from GetDisplayAspectX/Y, which is that size itself.",
    "width": 3840,
    "height": 2160,
    "virtualWidth": 320,
    "virtualHeight": 200,
    "vsyncNumerator": 35,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The core's own mixer (platform/i_sound.c): a step is a tic, 1260 frames at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 1260,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "SRB2 Legacy Controller",
    "_comment": "SRB2 Legacy's keyboard, pressed as keys - the menus read them too - and the menus' Enter and Escape (a prompt's yes and no too); and axes added into the tic command for exact values (Forward Move and Side Move count only while their keys are not held; Aim 0 leaves the game's own look). Spin is 2.1's \"use\" control. The ring-slinger controls are in but for the weapon slots (Weapon 1-10), left out to keep the UI uncrowded: Weapon Next and Prev reach every weapon. The order is srb2-input.c's. The mnemonics are each button's letter in a movie's text and TAStudio's column: the directions as Doom has them, arrows for moving and braces for turning.",
    "buttons": [
      "Forward",
      "Backward",
      "Strafe Left",
      "Strafe Right",
      "Turn Left",
      "Turn Right",
      "Look Up",
      "Look Down",
      "Jump",
      "Spin",
      "Fire",
      "Fire Normal",
      "Toss Flag",
      "Center View",
      "Reset Camera",
      "Camera Toggle",
      "Weapon Next",
      "Weapon Prev",
      "Custom 1",
      "Custom 2",
      "Custom 3",
      "Pause",
      "Enter",
      "Escape"
    ],
    "mnemonics": {
      "Forward": "^",
      "Backward": "v",
      "Strafe Left": "<",
      "Strafe Right": ">",
      "Turn Left": "{",
      "Turn Right": "}",
      "Look Up": "U",
      "Look Down": "D",
      "Jump": "J",
      "Spin": "S",
      "Fire": "F",
      "Fire Normal": "N",
      "Toss Flag": "G",
      "Center View": "C",
      "Reset Camera": "R",
      "Camera Toggle": "T",
      "Weapon Next": "+",
      "Weapon Prev": "-",
      "Custom 1": "1",
      "Custom 2": "2",
      "Custom 3": "3",
      "Pause": "P",
      "Enter": "E",
      "Escape": "e"
    },
    "axes": [
      {
        "name": "Forward Move",
        "min": -50,
        "max": 50,
        "neutral": 0,
        "header": "Fwd"
      },
      {
        "name": "Side Move",
        "min": -50,
        "max": 50,
        "neutral": 0,
        "header": "Side"
      },
      {
        "name": "Turn",
        "min": -32768,
        "max": 32767,
        "neutral": 0,
        "header": "Turn"
      },
      {
        "name": "Aim",
        "min": -32768,
        "max": 32767,
        "neutral": 0,
        "header": "Aim"
      }
    ]
  },
  "settings": [
    {
      "name": "analogControl",
      "display": "Analog Control",
      "type": "bool",
      "default": false,
      "description": "SRB2 2.1's Analog Control (SRB2's console variable useranalog). When it is on, the player faces and moves the way the input points, and the camera follows. When it is off, the player always faces the way the camera looks. SRB2's own default is off."
    },
    {
      "name": "cameraSpeed",
      "display": "Camera Speed",
      "type": "float",
      "default": 1.0,
      "description": "How quickly the camera catches up with the player, from 0 to 1 (SRB2's console variable cam_speed). SRB2's own default is 0.3."
    },
    {
      "name": "cameraDistance",
      "display": "Camera Distance",
      "type": "float",
      "default": 192.0,
      "description": "How far behind the player the camera is, in map units (SRB2's console variable cam_dist). The default is SRB2 2.2's. SRB2 Legacy's own default is 160."
    },
    {
      "name": "cameraHeight",
      "display": "Camera Height",
      "type": "float",
      "default": 40.0,
      "description": "How high above the player the camera is, in map units (SRB2's console variable cam_height). The default is SRB2 2.2's. SRB2 Legacy's own default is 25."
    },
    {
      "name": "fov",
      "display": "Field of View",
      "type": "float",
      "default": 90.0,
      "description": "How wide the camera's view is, in degrees across, from 60 to 179 (SRB2's console variable fov). It works in both renderers. The default, 90, is SRB2's. Leave it at 90 for normal levels and set it to 120 for NiGHTS levels, where the wider view shows more of the track ahead. It changes only the picture: the game plays the same at every field of view."
    },
    {
      "name": "scoreTimeRings",
      "display": "Score/Time/Rings",
      "type": "enum",
      "options": [
        "Normal",
        "Centiseconds",
        "Mania",
        "Tics"
      ],
      "default": "Mania",
      "description": "How the heads-up display (HUD) shows the time (SRB2's console variable timerres). Normal: m:ss. Centiseconds: m:ss.cc. Mania: m:ss.cc, with the score and ring counts lined up under it as in Sonic Mania. Tics: the number of tics (1/35 of a second) spent on the level."
    },
    {
      "name": "scorePos",
      "display": "Score Display",
      "type": "enum",
      "options": [
        "Normal",
        "Modern"
      ],
      "default": "Modern",
      "description": "Where the heads-up display (HUD) draws the score's number, both while playing and on the screen between levels (SRB2 Legacy's Score Display, console variable scorepos). Normal: where SRB2 2.1 draws it. Modern: 8 pixels further right, lined up with the time. SRB2 Legacy's own default is Normal. It changes only the picture: the game plays the same with either."
    },
    {
      "name": "flipCamera",
      "display": "Flip Camera with Gravity",
      "type": "bool",
      "default": true,
      "description": "Turns the camera upside down when the player's gravity is reversed (SRB2's console variable flipcam)."
    },
    {
      "name": "unlockModes",
      "display": "Unlock Record Attack and NiGHTS Mode",
      "type": "bool",
      "default": false,
      "description": "Starts with Record Attack and NiGHTS Mode unlocked, so a run does not need a movie that earns them first. SRB2 Legacy always offers Marathon Run."
    },
    {
      "name": "unlockMaps",
      "display": "Unlock All Maps in Record Attack and NiGHTS Mode",
      "type": "bool",
      "default": false,
      "description": "Lets every map that Record Attack and NiGHTS Mode list be chosen, whether it has been visited or not, including the maps of add-ons. Only the menu's check changes; the saved game data is not touched. The modes themselves also need Unlock Record Attack and NiGHTS Mode."
    },
    {
      "name": "unlockAll",
      "display": "Unlock All Secrets",
      "type": "bool",
      "default": false,
      "description": "Starts with everything that can be unlocked already unlocked: the modes, Level Select, Sound Test, Pandora's Box, the emblem hints and radar, and the rest."
    },
    {
      "name": "musicPref",
      "display": "Music Preference",
      "type": "enum",
      "options": [
        "Digital",
        "MIDI"
      ],
      "default": "Digital",
      "description": "Which of a song's two versions plays (SRB2's console variable musicpref). Digital: the recorded music (Ogg Vorbis). MIDI: the game's MIDI songs, played on six emulated YM2612 sound chips (the chip of the Sega Genesis / Mega Drive, using MAME's emulation), at SRB2's MIDI volume (midimusicvolume). A song that has only one version plays that one. It changes only the sound: the game plays the same with either."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl-hw"
      ],
      "default": "software",
      "description": "Which renderer draws the game. software: SRB2's software renderer. opengl-hw: SRB2's OpenGL renderer, drawn on this computer's graphics card (GPU) through Chimera's GPU bridge. It is fast, but the picture depends on the graphics driver, so Chimera marks a run made with it as not deterministic (not certain to replay exactly the same). If the GPU bridge is not available, the game is drawn in software instead, which plays differently, and the log says so. The renderer is part of the game, because a few things play differently in OpenGL, so a movie must be played back with the renderer it was made with."
    },
    {
      "name": "glShaders",
      "display": "OpenGL Shaders",
      "type": "bool",
      "default": true,
      "description": "Turns on the OpenGL renderer's shaders (SRB2's console variable gr_shaders), which give SRB2's lighting, fog and palette look. When it is off, the picture is drawn without shaders, in OpenGL's older fixed way. It changes only the picture: the game is the same either way."
    },
    {
      "name": "resolution",
      "display": "Resolution",
      "type": "enum",
      "options": [
        "3840x2160",
        "2560x1440",
        "1920x1200",
        "1920x1080",
        "1680x1050",
        "1600x1200",
        "1600x1000",
        "1600x900",
        "1536x864",
        "1366x768",
        "1440x900",
        "1280x1024",
        "1280x960",
        "1280x800",
        "1280x720",
        "1152x864",
        "1024x768",
        "960x600",
        "800x600",
        "640x480",
        "640x400",
        "320x240",
        "320x200"
      ],
      "default": "1280x800",
      "description": "The size of the picture, with square pixels. The choices are SRB2's own video modes, plus 2560x1440 and 3840x2160. SRB2's own default is 1280x800. Only the picture changes: the game plays the same at every resolution. A larger picture is slower to draw; turbo (fast forward) skips only the last conversion of the picture, not the drawing."
    },
    {
      "name": "warp",
      "display": "Start Map",
      "type": "string",
      "default": "",
      "description": "The map to start in, written as the game's -warp option takes it (a number, or MAPxx). Leave it empty to start as the game normally does, with the intro and the title screen. SRB2 treats warping as modifying the game, so the game data (unlocks, emblems and records) is then not saved."
    },
    {
      "name": "skin",
      "display": "Start Map Character",
      "type": "string",
      "default": "",
      "description": "The character to play in the Start Map, by its skin name: sonic, tails, knuckles, or one from an add-on (the game's +skin option). Leave it empty for the game's default, Sonic. It is used only together with a Start Map; without one, the character is chosen in the game's character select."
    }
  ],
  "firmware": [
